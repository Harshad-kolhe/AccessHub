# Optional: copy to .env.local to override.
# The AccessHub API as this Next.js server reaches it. The browser never calls the API for data.
API_URL=http://localhost:5177
# The API as the browser reaches it: only for the realtime hub and the Google/Microsoft sign-in redirect.
#PUBLIC_API_URL=http://localhost:5177
# Secure cookies need HTTPS (localhost counts). Set false to serve a production build over plain HTTP elsewhere.
#COOKIE_SECURE=false
