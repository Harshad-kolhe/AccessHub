{
  "Jwt": {
    "Issuer": "AccessHub",
    "Audience": "AccessHub.Web",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "SessionMaxDays": 30,
    "RefreshReuseGraceSeconds": 30,
    "InvitationDays": 3
  },
  "App": {
    "WebBaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "ForwardedHeaders": {
    "TrustedNetworks": []
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 20,
    "RefreshPermitPerMinute": 120
  },
  "Email": {
    "From": "AccessHub <no-reply@accesshub.local>",
    "Smtp": {
      "Host": "",
      "Port": 2525,
      "UseSsl": false
    }
  },
  "Hangfire": {
    "Enabled": true
  },
  "Authentication": {
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "" }
  },
  "Seed": {
    "DemoData": true,
    "DemoHistory": true
  },
  "Demo": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
