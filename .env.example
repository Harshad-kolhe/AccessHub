# AccessHub local configuration
#   1. Copy this file to .env            (PowerShell: Copy-Item .env.example .env)
#   2. Keep the ONE connection string below that matches your SQL Server.
#
# .env is git-ignored. The API loads it at startup (DotNetEnv); real environment variables override it.
# "__" is .NET's separator for nested keys: ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection.
# Single quotes keep values literal, so \ $ and ! are not interpreted.

# --- Database ------------------------------------------------------------------
# SQL Server LocalDB (installed with Visual Studio)
ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=AccessHub;Trusted_Connection=True;TrustServerCertificate=True'
# SQL Server Express
#ConnectionStrings__DefaultConnection='Server=.\SQLEXPRESS;Database=AccessHub;Trusted_Connection=True;TrustServerCertificate=True'
# Docker: run `docker compose up -d sqlserver` first; the password must match MSSQL_SA_PASSWORD below
#ConnectionStrings__DefaultConnection='Server=localhost,1433;Database=AccessHub;User Id=sa;Password=AccessHub_Strong_Pass123!;TrustServerCertificate=True'

# --- JWT signing key (HS256: at least 32 characters) ------------------------------
# Fine for local use. Generate a new random value for any shared or deployed environment.
Jwt__Key='local-dev-only-change-me-0123456789abcdef'

# --- Docker Compose: SA password for the SQL Server container -------------------
MSSQL_SA_PASSWORD='AccessHub_Strong_Pass123!'

# --- Email (optional) --------------------------------------------------------------
# Without an SMTP host, invitation and password-reset emails are written to the API's log instead, links included.
# To see them as real emails locally:  dotnet tool install -g Rnwood.Smtp4dev  then run  smtp4dev  (inbox: http://localhost:5000)
#Email__Smtp__Host='localhost'
#Email__Smtp__Port='25'
#Email__Smtp__UserName=''
#Email__Smtp__Password=''

# --- Sign in with Google / Microsoft (optional) -------------------------------------
# The buttons appear on the sign-in page only when both values of a provider are set. Redirect URIs to register:
#   Google:     http://localhost:5177/signin-google
#   Microsoft:  http://localhost:5177/signin-microsoft
#Authentication__Google__ClientId=''
#Authentication__Google__ClientSecret=''
#Authentication__Microsoft__ClientId=''
#Authentication__Microsoft__ClientSecret=''

# --- Public demo (optional) ----------------------------------------------------------
# Protects the shared demo accounts (no 2FA, password change or deactivation) and resets the demo data nightly.
#Demo__Enabled='true'
